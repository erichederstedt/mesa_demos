progs = [
  ['arbfslight', []],
  ['arbocclude', []],
  ['arbocclude2', []],
  ['bounce', []],
  ['clearspd', []],
  ['copypix', [idep_readtex]],
  ['cubemap', [idep_readtex]],
  ['cuberender', []],
  ['dinoshade', []],
  ['dissolve', [idep_readtex]],
  ['drawpix', [idep_readtex]],
  ['engine', [idep_readtex]],
  ['fbo_firecube', [idep_readtex]],
  ['fbotexture', []],
  ['fire', [idep_readtex]],
  ['fogcoord', []],
  ['fslight', []],
  ['gamma', []],
  ['gearbox', []],
  ['gears', []],
  ['geartrain', []],
  ['glinfo', []],
  ['gloss', [idep_readtex]],
  ['gltestperf', []],
  ['ipers', [idep_readtex]],
  ['isosurf', [idep_readtex]],
  ['lodbias', [idep_readtex]],
  ['morph3d', []],
  ['multiarb', [idep_readtex]],
  ['paltex', []],
  ['pixeltest', []],
  ['pointblast', []],
  ['projtex', [idep_readtex]],
  ['ray', []],
  ['readpix', [idep_readtex]],
  ['reflect', [idep_readtex]],
  ['renormal', []],
  ['shadowtex', []],
  ['singlebuffer', []],
  ['spectex', []],
  ['spriteblast', []],
  ['stex3d', []],
  ['teapot', [idep_readtex]],
  ['terrain', []],
  ['tessdemo', []],
  ['texcyl', [idep_readtex]],
  ['texenv', []],
  ['textures', [idep_readtex]],
  ['trispd', []],
  ['tunnel2', [idep_readtex]],
  ['tunnel', [idep_readtex]],
  ['vao_demo', []],
  ['winpos', [idep_readtex]],
]
base_deps = [dep_gl, dep_glu, dep_glut, dep_m, idep_glad, idep_util, dep_winmm]
foreach pair : progs
  p = pair[0]
  extra_deps = pair[1]
  executable(
    p,
    files(p + '.c'),
    dependencies: base_deps + extra_deps,
    install: true,
  )
endforeach
